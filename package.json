{
  "name": "flagproof-pre-event-prototype",
  "version": "0.1.0",
  "description": "Hash-approved plans and browser evidence across eight flag configurations, with a recorded Flagsmith Experimentation run",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "esbuild src/demo-browser.js --bundle --format=esm --outfile=public/demo.js && esbuild src/experiment-browser.js --bundle --format=esm --outfile=public/experiment.js",
    "start": "npm run build && node src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "capture": "node test/capture-ui.mjs",
    "setup:flagsmith": "node scripts/setup-flagsmith.mjs",
    "traffic:experiment": "node scripts/run-experiment-traffic.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@flagsmith/flagsmith": "^12.5.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@flagsmith/nodejs": "^9.5.0"
  }
}
